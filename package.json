{
  "name": "tokens",
  "version": "1.3.0",
  "description": "Design tokens shared by Roger Padilla's sites: GitHub Primer's colour roles, generated from @primer/primitives, for CSS and scripts, plus one motion, radius and spacing scale and a WCAG contrast helper.",
  "license": "MIT",
  "type": "module",
  "files": [
    "primer.css",
    "primer.js",
    "primer.d.ts",
    "scale.css",
    "contrast.js",
    "contrast.d.ts",
    "check.js",
    "check.d.ts"
  ],
  "exports": {
    "./primer.css": "./primer.css",
    "./scale.css": "./scale.css",
    "./primer.js": {
      "types": "./primer.d.ts",
      "default": "./primer.js"
    },
    "./contrast.js": {
      "types": "./contrast.d.ts",
      "default": "./contrast.js"
    },
    "./check.js": {
      "types": "./check.d.ts",
      "default": "./check.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun scripts/build.ts --check && tsc && bun test"
  },
  "devDependencies": {
    "@primer/primitives": "11.10.0",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
